<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Affichage : plein écran, fond sombre pendant le chargement -->
    <style name="Theme.Ecran" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
    <!-- Réglages : thème sombre standard -->
    <style name="Theme.Reglages" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/fond</item>
        <item name="android:textColorPrimary">@color/texte</item>
        <item name="android:textColorSecondary">@color/texte_attenue</item>
    </style>

    <style name="Libelle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/texte</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Champ">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">640dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/texte</item>
        <item name="android:textColorHint">@color/texte_attenue</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Aide">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texte_attenue</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Case">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/texte</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
