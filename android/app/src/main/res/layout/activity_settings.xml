<?xml version="1.0" encoding="utf-8"?>
<!-- Réglages : utilisables à la télécommande (navigation haut / bas, OK) comme au doigt -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reglages_titre"
            android:textColor="@color/texte"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Libelle"
            android:text="@string/serveur" />
        <EditText
            android:id="@+id/server_input"
            style="@style/Champ"
            android:hint="192.168.1.20"
            android:imeOptions="actionNext"
            android:inputType="textUri" />
        <TextView
            style="@style/Aide"
            android:text="@string/serveur_aide" />

        <TextView
            style="@style/Libelle"
            android:text="@string/ecran" />
        <EditText
            android:id="@+id/screen_input"
            style="@style/Champ"
            android:hint="hall"
            android:imeOptions="actionDone"
            android:inputType="text" />
        <TextView
            style="@style/Aide"
            android:text="@string/ecran_aide" />

        <CheckBox
            android:id="@+id/lite_check"
            style="@style/Case"
            android:text="@string/lite" />
        <CheckBox
            android:id="@+id/autostart_check"
            style="@style/Case"
            android:text="@string/demarrage" />
        <CheckBox
            android:id="@+id/home_check"
            style="@style/Case"
            android:text="@string/accueil" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accent"
                android:text="@string/enregistrer"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/test_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/tester" />
        </LinearLayout>

        <TextView
            android:id="@+id/test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texte"
            android:textSize="15sp" />

        <Button
            android:id="@+id/overlay_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/autoriser"
            android:visibility="gone" />
        <Button
            android:id="@+id/android_settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/parametres_android" />

        <TextView
            android:id="@+id/info_text"
            style="@style/Aide"
            android:layout_marginTop="24dp" />
        <TextView
            style="@style/Aide"
            android:text="@string/raccourcis" />
    </LinearLayout>
</ScrollView>
